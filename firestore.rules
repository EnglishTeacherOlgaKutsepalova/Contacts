rules_version = '2';

// ============================================================
// ПРАВИЛА БЕЗОПАСНОСТИ FIRESTORE
// Скопируйте это в Firebase Console → Firestore Database → Rules
// и нажмите Publish.
//
// Логика:
//  - students: читать документ можно только "напрямую по id"
//    (get), т.к. ссылка ученика уже сама по себе секрет.
//    Список всех учеников (list) закрыт — иначе можно было бы
//    получить данные всех учеников разом. Изменять может только
//    вошедший администратор.
//  - resources / books: публичная витрина — читать может любой,
//    менять может только администратор.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /students/{studentId} {
      allow get: if true;          // чтение по прямой ссылке (личный кабинет)
      allow list: if request.auth != null;   // список — только админ (в панели)
      allow write: if request.auth != null;  // добавление/редактирование — только админ
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
